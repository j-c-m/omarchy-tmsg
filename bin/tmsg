#!/bin/sh
# Start the tMsg terminal screen from this checkout.
# A second run focuses the screen that is already open.
root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd) || exit 1
cd "$root" || exit 1
if [ "${1:-}" = "--inside" ]; then
  shift
  exec python3 -m tui "$@"
fi
exec python3 -m tui --launch "$@"
